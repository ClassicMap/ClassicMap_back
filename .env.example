# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=classicmap
MYSQL_USER=user
MYSQL_PASSWORD=your_password_here

# Database Connection URL
# For Docker: use 'mysql' as host (service name)
# For local development: use 'localhost'
DATABASE_URL=mysql://user:your_password_here@mysql:3306/classicmap

# Clipper와 공유하는 홈서버 host cache 절대 경로
CLASSICMAP_CLIP_CACHE_HOST_DIR=/absolute/path/to/Classicmap/video-clips/cache

# Logging Configuration
RUST_LOG=off
SQLX_LOG=off

# Admin and Moderator Configuration
ADMIN_EMAILS=admin@example.com
MODERATOR_EMAILS=moderator1@example.com,moderator2@example.com

# Clerk JWT Authentication
# Get your public key from Clerk Dashboard
CLERK_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
YOUR_CLERK_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"

# Internal API Key (for cache warmup etc.)
INTERNAL_API_KEY=your_internal_api_key_here

# KOPIS API Configuration
# Get your API key from: https://www.kopis.or.kr/por/cs/openapi/openApiInfo.do
KOPIS_API_KEY=your_kopis_api_key_here

# Apple Music API (연주자별 새 앨범 동기화). 셋 중 하나라도 비면 동기화가 꺼진다.
# APPLE_MUSIC_PRIVATE_KEY 는 .p8 내용을 한 줄로 넣고 줄바꿈은 \n 으로 적는다.
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_TEAM_KEY=
# 선택. 기본 us (시드 앨범 제목이 영어라 맞춘다)
APPLE_MUSIC_STOREFRONT=
