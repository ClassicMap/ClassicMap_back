%2Fwatch%3Fv%3DLtzUyP2lokk&format=json", "oembedHttpStatus": 200}, "rightsMode": "unknown"}, "credits": [{"roleCode": "SOLOIST", "isPrimary": true, "displayOrder": 0, "entityCandidate": {"preferredName": "Arabella Steinbacher", "externalIdentifiers": [{"namespace": "wikidata", "value": "Q84934", "sourceUrl": "https://www.wikidata.org/wiki/Q84934"}]}}], "clip": {"startSeconds": 0, "endSeconds": 366, "timelineMethod": "AUDIO_DETECTED_ARRANGEMENTS", "verificationNote": "박수와 무음을 걷어내고 조성 성분이 이어지는 구간을 작품으로 보아 경계를 잡았다. 같은 곡의 다른 연주와 교차 정렬해 같은 음악인지 확인했다."}, "publicationGate": "RIGHTS_AND_CLIP_ASSET_REQUIRED"}
